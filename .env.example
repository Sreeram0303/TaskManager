# Copy this file to .env and fill in real values.
# .env itself is gitignored — never commit real secrets.

# Postgres (running via docker-compose.yml — matches the values below)
POSTGRES_USER=taskmanager_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=taskmanager
DB_CONNECTION=postgresql://taskmanager_user:change-me@localhost:5432/taskmanager

# JWT signing secret — generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-real-64-char-hex-secret

# Redis (also via docker-compose.yml)
REDIS_URL=redis://localhost:6379

# Resend (https://resend.com) — used for the welcome-email queue worker
RESEND_API_KEY=your-resend-api-key

# False for local dev (plain http://localhost). Set True only once this is
# actually deployed behind real HTTPS — otherwise the browser silently
# refuses to ever send the refresh/csrf cookies back.
COOKIE_SECURE=False
